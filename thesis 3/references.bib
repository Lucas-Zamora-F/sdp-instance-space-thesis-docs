@misc{sunSDPNALMatlabSoftware2019,
  title = {{{SDPNAL}}+: {{A Matlab}} Software for Semidefinite Programming with Bound Constraints (Version 1.0)},
  shorttitle = {{{SDPNAL}}+},
  author = {Sun, Defeng and Toh, Kim-Chuan and Yuan, Yancheng and Zhao, Xin-Yuan},
  year = 2019,
  month = may,
  number = {arXiv:1710.10604},
  eprint = {1710.10604},
  primaryclass = {math.OC},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1710.10604},
  urldate = {2026-06-30},
  abstract = {SDPNAL+ is a \textbraceleft\textbackslash sc Matlab\textbraceright{} software package that implements an augmented Lagrangian based method to solve large scale semidefinite programming problems with bound constraints. The implementation was initially based on a majorized semismooth Newton-CG augmented Lagrangian method, here we designed it within an inexact symmetric Gauss-Seidel based semi-proximal ADMM/ALM (alternating direction method of multipliers/augmented Lagrangian method) framework for the purpose of deriving simpler stopping conditions and closing the gap between the practical implementation of the algorithm and the theoretical algorithm. The basic code is written in \textbraceleft\textbackslash sc Matlab\textbraceright, but some subroutines in C language are incorporated via Mex files. We also design a convenient interface for users to input their SDP models into the solver. Numerous problems arising from combinatorial optimization and binary integer quadratic programming problems have been tested to evaluate the performance of the solver. Extensive numerical experiments conducted in [Yang, Sun, and Toh, Mathematical Programming Computation, 7 (2015), pp. 331--366] show that the proposed method is quite efficient and robust, in that it is able to solve 98.9\textbackslash\% of the 745 test instances of SDP problems arising from various applications to the accuracy of \$ 10\textasciicircum\textbraceleft -6\textbraceright\$ in the relative KKT residual.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Optimization and Control},
  file = {C\:\\Users\\Lucas Zamora\\Zotero\\storage\\GDUICICI\\Sun et al. - 2019 - SDPNAL+ A Matlab software for semidefinite programming with bound constraints (version 1.0).pdf;C\:\\Users\\Lucas Zamora\\Zotero\\storage\\DSX38V7H\\1710.html}
